{
  "name": "gps-digest",
  "version": "0.1.0",
  "description": "Compacte les fichiers de montres GPS (TCX, GPX, FIT) en résumés CSV ingérables par un LLM.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "node --experimental-strip-types test/run.ts && node --experimental-strip-types test/analysis.ts",
    "typecheck": "npx tsc --noEmit",
    "build": "node scripts/build.mjs",
    "deploy": "npm run typecheck && npm test && npm run build && wrangler deploy",
    "preview": "wrangler dev",
    "dev": "node scripts/dev-server.mjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "interop": "node --experimental-strip-types scripts/interop.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tpripri/gps-digest.git"
  }
}
